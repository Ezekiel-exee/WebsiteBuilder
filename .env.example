# Byte Brawl online play (Supabase Realtime). Copy this file to .env.local and fill in your project's values.
# Project Settings -> API in the Supabase dashboard. The anon/publishable key is safe to expose in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
